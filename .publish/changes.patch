+++ b/packaging/windows/japanese/prepare_payload.py
@@ -0,0 +1,91 @@
+"""Assemble the licensed native runtime for the single-EXE Japanese package."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import zipfile
+
+from public_binary import redact
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--work", type=Path, required=True)
+    parser.add_argument("--fonts", type=Path, required=True)
+    parser.add_argument("--metadata", type=Path, required=True)
+    parser.add_argument("--crt", type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[3]
+    binary = root / "target/release/photocraft.exe"
+    stage = args.work / "payload"
+    stage.mkdir()
+    public_binary, redactions = redact(binary.read_bytes(), str(Path.home()))
+    (stage / "photocraft.exe").write_bytes(public_binary)
+    (stage / "photocraft.sha256").write_text(hashlib.sha256(public_binary).hexdigest() + "\n", encoding="utf-8")
+    print(f"Anonymized native diagnostic prefixes: {redactions}")
+    licenses = stage / "licenses"
+    licenses.mkdir()
+    for name in ("LICENSE-MIT", "LICENSE-APACHE", "NOTICE", "ATTRIBUTION.md"):
+        shutil.copy2(root / name, licenses / name)
+    with (licenses / "NOTICE").open("a", encoding="utf-8") as file:
+        file.write("\nLocal Japanese edition: completed Japanese UI catalog, familiar image-editing terminology, and single-executable launcher.\n")
+        file.write("Upstream: https://github.com/storytold/photocraft, version 0.20.1.\n")
+    for path in (root / "assets/fonts").glob("OFL*.txt"):
+        shutil.copy2(path, licenses / path.name)
+    for directory in (root / "assets", root / "crates/ui-egui/src"):
+        for path in directory.rglob("LICENSE*.txt"):
+            relative = path.relative_to(root)
+            shutil.copy2(path, licenses / ("PROJECT-" + "-".join(relative.parts)))
+    for path in (args.fonts / "fonts").rglob("OFL.txt"):
+        shutil.copy2(path, licenses / ("OFL-" + path.parent.name + ".txt"))
+    shutil.copy2(args.fonts / "ATTRIBUTION.md", licenses / "CRAFT-FONTS-ATTRIBUTION.md")
+    for name in ("vcruntime140.dll", "vcruntime140_1.dll", "msvcp140.dll", "msvcp140_1.dll", "msvcp140_2.dll", "concrt140.dll"):
+        shutil.copy2(args.crt / name, stage / name)
+    metadata = json.loads(args.metadata.read_text(encoding="utf-8-sig"))
+    notices = []
+    no_license_file = []
+    for package in sorted(metadata["packages"], key=lambda p: (p["name"], p["version"])):
+        if package.get("source") is None:
+            continue
+        header = f"{package['name']} {package['version']}\nLicense: {package.get('license') or 'see license text'}\n"
+        if package.get("repository"):
+            header += package["repository"] + "\n"
+        base = Path(package["manifest_path"]).parent
+        files = []
+        # Git workspaces often keep the license at the repository root.
+        for parent in (base, *list(base.parents)[:5]):
+            files = [p for p in parent.iterdir() if p.is_file() and p.name.upper().startswith(("LICENSE", "LICENCE", "COPYING", "NOTICE", "COPYRIGHT"))]
+            if files or parent.name in ("registry", "checkouts"):
+                break
+        if package.get("license_file"):
+            explicit = base / package["license_file"]
+            if explicit.is_file() and explicit not in files:
+                files.append(explicit)
+        if not files:
+            no_license_file.append(package["name"])
+        text = "\n".join(p.read_text(encoding="utf-8", errors="replace") for p in sorted(files))
+        notices.append("=" * 72 + "\n" + header + "\n" + text + "\n")
+    (licenses / "THIRD-PARTY-NOTICES.txt").write_text("\n".join(notices), encoding="utf-8")
+    (licenses / "MICROSOFT-RUNTIME-NOTICE.txt").write_text(
+        "Microsoft Visual C++ runtime libraries are included app-locally from the licensed Visual Studio Build Tools redistributable directory.\n"
+        "Copyright Microsoft Corporation. All rights reserved.\n",
+        encoding="utf-8",
+    )
+    payload = args.work / "photocraft-ja-payload.zip"
+    with zipfile.ZipFile(payload, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
+        for path in sorted(stage.rglob("*")):
+            if path.is_file():
+                archive.write(path, path.relative_to(stage).as_posix())
+    print(f"Payload files: {sum(p.is_file() for p in stage.rglob('*'))}")
+    print(f"Payload bytes: {payload.stat().st_size}")
+    print(f"Third-party packages: {len(notices)}; packages without standalone license file: {len(no_license_file)}")
+    if no_license_file:
+        print("SPDX-only entries: " + ", ".join(no_license_file))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/packaging/windows/japanese/public_binary.py b/packaging/windows/japanese/public_binary.py
new file mode 100644
index 0000000..4038c4d
--- /dev/null
+++ b/packaging/windows/japanese/public_binary.py
@@ -0,0 +1,75 @@
+"""Remove local Rust diagnostic source prefixes without changing executable code."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import re
+import struct
+
+
+def sections(data: bytes) -> list[tuple[str, int, int]]:
+    if data[:2] != b"MZ":
+        raise ValueError("Not a PE executable")
+    pe = struct.unpack_from("<I", data, 0x3C)[0]
+    if data[pe:pe + 4] != b"PE\0\0":
+        raise ValueError("Invalid PE header")
+    count = struct.unpack_from("<H", data, pe + 6)[0]
+    optional = struct.unpack_from("<H", data, pe + 20)[0]
+    # Editing a signed executable would invalidate its signature.
+    if struct.unpack_from("<H", data, pe + 24)[0] != 0x20B:
+        raise ValueError("Expected a PE32+ executable")
+    if struct.unpack_from("<II", data, pe + 24 + 112 + 4 * 8) != (0, 0):
+        raise ValueError("Refusing to modify a signed executable")
+    result = []
+    for index in range(count):
+        offset = pe + 24 + optional + index * 40
+        name = data[offset:offset + 8].rstrip(b"\0").decode("ascii")
+        size, start = struct.unpack_from("<II", data, offset + 16)
+        result.append((name, start, start + size))
+    return result
+
+
+def redact(data: bytes, private_prefix: str) -> tuple[bytes, int]:
+    layout = sections(data)
+    output = bytearray(data)
+    replacements = 0
+    variants = {private_prefix, private_prefix.replace("\\", "/")}
+    for prefix in variants:
+        needle = prefix.encode("utf-8")
+        if not needle:
+            raise ValueError("An empty private prefix is invalid")
+        public = b"C:\\Build\\" if "\\" in prefix else b"/build/"
+        replacement = (public + b"_" * len(needle))[:len(needle)]
+        for match in re.finditer(re.escape(needle), data):
+            start, end = match.span()
+            owner = next((s for s in layout if s[1] <= start and end <= s[2]), None)
+            # Only known Rust diagnostic paths in read-only data may be changed. Equal byte
+            # lengths preserve pointers and string lengths; all machine code stays identical.
+            tail = data[end:min(end + 192, len(data))]
+            if owner is None or owner[0] != ".rdata" or b".rs" not in tail:
+                raise ValueError("A private path is not a recognized Rust diagnostic string")
+            output[start:end] = replacement
+            replacements += 1
+    result = bytes(output)
+    if len(result) != len(data) or sections(result) != layout:
+        raise ValueError("PE layout changed")
+    for name, start, end in layout:
+        if name != ".rdata" and result[start:end] != data[start:end]:
+            raise ValueError("Executable code or another PE section changed")
+    return result, replacements
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("source", type=Path)
+    parser.add_argument("destination", type=Path)
+    parser.add_argument("--private-prefix", default=str(Path.home()))
+    args = parser.parse_args()
+    result, count = redact(args.source.read_bytes(), args.private_prefix)
+    args.destination.write_bytes(result)
+    print(f"Anonymized {count} diagnostic source prefixes; machine code and PE layout unchanged.")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/packaging/windows/japanese/test_public_binary.py b/packaging/windows/japanese/test_public_binary.py
new file mode 100644
index 0000000..f5736c8
--- /dev/null
+++ b/packaging/windows/japanese/test_public_binary.py
@@ -0,0 +1,49 @@
+import struct
+import unittest
+
+from public_binary import redact
+
+
+def fixture(text: bytes, data: bytes) -> bytes:
+    image = bytearray(0x800)
+    image[:2] = b"MZ"
+    struct.pack_into("<I", image, 0x3C, 0x80)
+    image[0x80:0x84] = b"PE\0\0"
+    struct.pack_into("<HH", image, 0x84, 0x8664, 2)
+    struct.pack_into("<H", image, 0x94, 0xF0)
+    struct.pack_into("<H", image, 0x98, 0x20B)
+    for i, (name, start) in enumerate([(b".text", 0x400), (b".rdata", 0x600)]):
+        offset = 0x188 + i * 40
+        image[offset:offset + len(name)] = name
+        struct.pack_into("<II", image, offset + 16, 0x200, start)
+    image[0x400:0x400 + len(text)] = text
+    image[0x600:0x600 + len(data)] = data
+    return bytes(image)
+
+
+class PublicBinaryTests(unittest.TestCase):
+    def test_only_diagnostic_data_is_redacted(self):
+        original = fixture(b"machine-code", b"C:\\Users\\private\\library\\file.rs")
+        public, count = redact(original, "C:\\Users\\private")
+        self.assertEqual(count, 1)
+        self.assertNotIn(b"private", public)
+        self.assertEqual(original[:0x600], public[:0x600])
+        self.assertEqual(len(original), len(public))
+
+    def test_code_section_is_never_modified(self):
+        with self.assertRaises(ValueError):
+            redact(fixture(b"C:\\Users\\private\\file.rs", b""), "C:\\Users\\private")
+
+    def test_non_diagnostic_path_is_refused(self):
+        with self.assertRaises(ValueError):
+            redact(fixture(b"", b"C:\\Users\\private\\runtime.ttf\0"), "C:\\Users\\private")
+
+    def test_signed_binary_is_refused(self):
+        image = bytearray(fixture(b"", b"C:\\Users\\private\\file.rs"))
+        struct.pack_into("<II", image, 0x98 + 112 + 4 * 8, 0x1000, 20)
+        with self.assertRaises(ValueError):
+            redact(bytes(image), "C:\\Users\\private")
+
+
+if __name__ == "__main__":
+    unittest.main()
