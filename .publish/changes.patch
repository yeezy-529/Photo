+#[test]
+fn japanese_uses_familiar_image_editing_terms_and_contexts() {
+    let ja = JA();
+    for (source, translated) in [
+        ("Select", "選択範囲"),
+        ("Curves", "トーンカーブ"),
+        ("Photo Filter", "レンズフィルター"),
+        ("Vibrance", "自然な彩度"),
+        ("Blending Mode", "描画モード"),
+        ("Preferences…", "環境設定…"),
+    ] {
+        assert_eq!(tr(ja, source), translated);
+    }
+    assert_eq!(tr_id(ja, "edit.stroke", "Stroke…"), "境界線を描く…");
+    assert_eq!(tr_ctx(ja, "layers", "Fill"), "塗り");
+    assert_eq!(tr_ctx(ja, "smartSvg", "Edit SVG Smart Object"), "SVG スマートオブジェクトを編集");
+}
+
+#[test]
+fn japanese_import_and_save_notices_keep_names_and_counts() {
+    let ja = JA();
+    assert_eq!(trn(ja, 3, "Imported {n} brush from {file}", "Imported {n} brushes from {file}"), "{file} から 3 個のブラシを読み込みました");
+    assert_eq!(fmt(tr(ja, "Saved a copy as {path}"), &[("path", "作品.psd")]), "コピーを 作品.psd に保存しました");
+    assert_ne!(
+        tr(ja, "No slices are selected. Click a slice in the preview to select it."),
+        "No slices are selected. Click a slice in the preview to select it."
+    );
+    assert_eq!(tr(ja, "User-authored layer name"), "User-authored layer name");
+}
